{
  "name": "htr-convex",
  "version": "0.1.0",
  "private": true,
  "description": "Hold the Room on Convex: reads everything, drafts everything, sends nothing until the owner rules.",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "deploy": "npx @convex-dev/static-hosting deploy",
    "deploy:dev": "npx @convex-dev/static-hosting upload --build"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.56",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  }
}
