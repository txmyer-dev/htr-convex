# Convex fills CONVEX_DEPLOYMENT and VITE_CONVEX_URL in .env.local when you run `npx convex dev`.
# Everything below is set on the Convex deployment (`npx convex env set NAME value`), not here.

# The drafter: any OpenAI-compatible chat-completions endpoint (OpenAI itself, or Omniroute).
OPENAI_API_KEY=
OPENAI_BASE_URL=            # blank = api.openai.com; https://omniroute.felaniam.cloud/v1 for the gateway
OPENAI_MODEL=gpt-5-mini

# AgentMail: the assistant's inbox (the counterparty channel) and the webhook secret.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# Firecrawl: reads the client's business site so drafts rest on what the site actually says.
FIRECRAWL_API_KEY=

# Signs the Send / Skip links in every digest. Any long random string.
HTR_RULING_SECRET=
