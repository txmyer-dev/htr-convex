# Convex fills CONVEX_DEPLOYMENT and VITE_CONVEX_URL in .env.local when you run `npx convex dev`.
# Everything below is set on the Convex deployment (`npx convex env set NAME value`), not here.

# The drafter: any OpenAI-compatible chat-completions endpoint (OpenAI itself, or Omniroute).
OPENAI_API_KEY=
OPENAI_BASE_URL=            # blank = api.openai.com; https://omniroute.felaniam.cloud/v1 for the gateway
OPENAI_MODEL=gpt-5.4-mini            # in the free daily tier (2.5M tokens/day across the mini and nano models)
OPENAI_EMBED_MODEL=text-embedding-3-small   # 1536 dimensions: the chunks table's vector index; the site in pieces

# AgentMail: the assistant's inbox (the counterparty channel) and the webhook secret.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# Firecrawl: reads the client's business site so drafts rest on what the site actually says.
FIRECRAWL_API_KEY=

# Signs the Send / Skip links in every digest. Any long random string.
HTR_RULING_SECRET=

# The front door: how many AgentMail inboxes the demo pool may hold. The free plan allows three
# in all; client zero holds one, so the default is 2.
HTR_DEMO_POOL=1
# How many pages of a business site Firecrawl crawls (one credit each). Default 20.
HTR_CRAWL_PAGES=20
# Signs site requests to the web agent (x-htr-site). Optional; falls back to HTR_RULING_SECRET.
HTR_SITE_SECRET=
